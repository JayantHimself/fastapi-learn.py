from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI()

#Allowed Origins(Front-end URl)
origins = [
    "http://localhost:5173"     ## HERE PASTE THE URL OF THE FRONTEND CODE (for eg. React js, html ,,or in any other lang. we want to connect with backend)
]

app.add_middleware(
    CORSMiddleware,
    allow_origins = origins, #allowed FE
    allow_credentials = True,
    allow_methods = ["*"], #GET,PUT,POST,DELETE
    allow_headers=["*"]
)

@app.get("/")
def home():
    return{
        "message":"CORS IS ENABLE API"
    }
